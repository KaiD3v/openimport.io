# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database — local Docker Compose Postgres
DATABASE_URL=postgresql://openimport:openimport@localhost:5434/openimport

# CORS — comma-separated absolute origins. Wildcard is rejected in production.
ALLOWED_ORIGINS=http://localhost:5173

# OpenAPI UI (`/docs`) and JSON (`/docs-json`) are enabled outside production.
# Set to true to expose docs in production.
ENABLE_DOCS=false

# Import upload limits (conservative development defaults)
IMPORT_MAX_FILE_BYTES=5242880
IMPORT_MAX_DATA_ROWS=10000
IMPORT_MAX_COLUMNS=50
IMPORT_MAX_FIELD_BYTES=65536

# Object storage — local Docker Compose MinIO (S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=openimport
S3_SECRET_ACCESS_KEY=openimportsecret
S3_BUCKET=openimport
S3_FORCE_PATH_STYLE=true

# Redis — local Docker Compose (BullMQ import processing).
# Development / start:prod uses logical DB 0. E2E uses DB 15 exclusively
# (see vitest.config.e2e.ts). Do not point E2E at DB 0.
REDIS_URL=redis://localhost:6379/0
IMPORT_WORKER_CONCURRENCY=2
IMPORT_WORKER_MAX_ATTEMPTS=5
IMPORT_WORKER_BACKOFF_MS=2000
IMPORT_PERSIST_BATCH_SIZE=100
IMPORT_REJECTED_ROWS_MAX_LIMIT=50
IMPORT_VALID_ROWS_MAX_LIMIT=100
IMPORT_RESULT_BATCH_MAX_SIZE=100
IMPORT_JOB_RECONCILE_INTERVAL_MS=15000
IMPORT_JOB_RECONCILE_BATCH_SIZE=25

# CSV object retention (S3/MinIO). Deletes storage for ready / processing_failed
# sessions after the TTL; PostgreSQL session/records/results are kept.
IMPORT_FILE_RETENTION_HOURS=168
IMPORT_FILE_CLEANUP_INTERVAL_MS=60000
IMPORT_FILE_CLEANUP_BATCH_SIZE=25
IMPORT_FILE_CLEANUP_CLAIM_MS=120000

# Outbound signed webhooks (`import.ready`).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET_ENCRYPTION_KEY=
WEBHOOK_WORKER_CONCURRENCY=4
WEBHOOK_WORKER_MAX_ATTEMPTS=5
WEBHOOK_WORKER_BACKOFF_MS=2000
WEBHOOK_DELIVERY_TIMEOUT_MS=5000
WEBHOOK_JOB_RECONCILE_INTERVAL_MS=15000
WEBHOOK_JOB_RECONCILE_BATCH_SIZE=25
# Must stay false in production. E2E sets true to allow a loopback receiver.
WEBHOOK_SSRF_ALLOW_PRIVATE_TARGETS=false

# Readiness probe timeout per dependency (PostgreSQL, Redis, object storage).
HEALTH_PROBE_TIMEOUT_MS=2000

# HTTP hardening (production defaults; safe to leave as-is locally).
# TRUST_PROXY=false keeps Express from trusting X-Forwarded-For.
# Use a hop count (e.g. 1) or CIDR list when nginx (or another reverse proxy)
# sits in front. "true" is coerced to loopback — never unrestricted trust.
TRUST_PROXY=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_PRE_AUTH_MAX=600
RATE_LIMIT_MAX=300
RATE_LIMIT_UPLOAD_MAX=20
RATE_LIMIT_PREVIEW_MAX=60
RATE_LIMIT_CONFIRM_MAX=30
RATE_LIMIT_ACCESS_TOKEN_MAX=30
RATE_LIMIT_WEBHOOK_MAX=20
# Only true when TRUST_PROXY is set; then rate-limit keys use request.ip.
RATE_LIMIT_TRUSTED_PROXY=false
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_HEADERS_TIMEOUT_MS=15000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
HTTP_MAX_REQUESTS_PER_SOCKET=100

# Local seed only. Never used by the HTTP API.
# Generate a high-entropy key, then keep it in your private `.env`:
#   node -e "console.log('oi_live_'+require('crypto').randomBytes(32).toString('hex'))"
# Format: oi_live_ followed by exactly 64 hexadecimal characters. Leave empty here.
SEED_API_KEY=
SEED_ORGANIZATION_NAME=Local Development

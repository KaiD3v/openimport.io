generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TemplateFieldType {
  string
  integer
  currency

  @@map("template_field_type")
}

enum ImportSessionStatus {
  created
  uploaded
  queued
  processing
  ready
  processing_failed
  upload_failed

  @@map("import_session_status")
}

enum ImportExecutionStatus {
  queued
  processing
  ready
  failed

  @@map("import_execution_status")
}

enum ImportRecordClassification {
  valid
  invalid

  @@map("import_record_classification")
}

model Organization {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  apiKeys            ApiKey[]
  templates          ImportTemplate[]
  importSessions     ImportSession[]
  importAccessTokens ImportAccessToken[]
  importExecutions   ImportExecution[]
  importRecords      ImportRecord[]

  @@map("organizations")
}

model ApiKey {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String    @db.VarChar(100)
  keyHash        String    @unique(map: "uq_api_keys_key_hash") @map("key_hash") @db.VarChar(64)
  keyPrefix      String    @map("key_prefix") @db.VarChar(24)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  issuedAccessTokens ImportAccessToken[]

  @@index([organizationId], map: "idx_api_keys_organization_id")
  @@map("api_keys")
}

model ImportTemplate {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(100)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fields         TemplateField[]
  importSessions ImportSession[]

  @@unique([organizationId, name], map: "uq_import_templates_organization_id_name")
  @@map("import_templates")
}

model TemplateField {
  id         String            @id @default(uuid(7)) @db.Uuid
  templateId String            @map("template_id") @db.Uuid
  key        String            @db.VarChar(64)
  label      String            @db.VarChar(120)
  type       TemplateFieldType
  required   Boolean
  position   Int

  template ImportTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, key], map: "uq_template_fields_template_id_key")
  @@unique([templateId, position], map: "uq_template_fields_template_id_position")
  @@map("template_fields")
}

model ImportSession {
  id                  String              @id @default(uuid(7)) @db.Uuid
  organizationId      String              @map("organization_id") @db.Uuid
  templateId          String              @map("template_id") @db.Uuid
  status              ImportSessionStatus @default(created)
  idempotencyKeyHash  String              @map("idempotency_key_hash") @db.VarChar(64)
  requestFingerprint  String              @map("request_fingerprint") @db.VarChar(64)
  originalFilename    String?             @map("original_filename") @db.VarChar(255)
  byteSize            Int?                @map("byte_size")
  contentSha256       String?             @map("content_sha256") @db.VarChar(64)
  encoding            String?             @db.VarChar(32)
  delimiter           String?             @db.VarChar(8)
  dataRowCount        Int?                @map("data_row_count")
  storageObjectKey    String?             @map("storage_object_key") @db.VarChar(512)
  mapping             Json                @default("[]") @db.JsonB
  mappingRevision     Int                 @default(0) @map("mapping_revision")
  uploadedAt          DateTime?           @map("uploaded_at") @db.Timestamptz(6)
  confirmedAt         DateTime?           @map("confirmed_at") @db.Timestamptz(6)
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template     ImportTemplate      @relation(fields: [templateId], references: [id], onDelete: Restrict)
  columns      ImportColumn[]
  accessTokens ImportAccessToken[]
  executions   ImportExecution[]
  records      ImportRecord[]

  @@unique([organizationId, idempotencyKeyHash], map: "uq_import_sessions_org_idempotency_key_hash")
  @@index([organizationId], map: "idx_import_sessions_organization_id")
  @@index([organizationId, templateId], map: "idx_import_sessions_organization_id_template_id")
  @@index([organizationId, id], map: "idx_import_sessions_organization_id_id")
  @@map("import_sessions")
}

model ImportExecution {
  id                       String                @id @default(uuid(7)) @db.Uuid
  organizationId           String                @map("organization_id") @db.Uuid
  importSessionId          String                @map("import_session_id") @db.Uuid
  status                   ImportExecutionStatus @default(queued)
  confirmationFingerprint  String                @map("confirmation_fingerprint") @db.VarChar(64)
  expectedMappingRevision  Int                   @map("expected_mapping_revision")
  expectedContentSha256    String                @map("expected_content_sha256") @db.VarChar(64)
  jobId                    String                @unique(map: "uq_import_executions_job_id") @map("job_id") @db.VarChar(160)
  attempt                  Int                   @default(0)
  processedRows            Int                   @default(0) @map("processed_rows")
  totalRows                Int?                  @map("total_rows")
  validRows                Int                   @default(0) @map("valid_rows")
  invalidRows              Int                   @default(0) @map("invalid_rows")
  errorCode                String?               @map("error_code") @db.VarChar(80)
  errorMessage             String?               @map("error_message") @db.VarChar(500)
  startedAt                DateTime?             @map("started_at") @db.Timestamptz(6)
  finishedAt               DateTime?             @map("finished_at") @db.Timestamptz(6)
  createdAt                DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  importSession ImportSession  @relation(fields: [importSessionId], references: [id], onDelete: Cascade)
  records       ImportRecord[]

  @@unique([importSessionId, confirmationFingerprint], map: "uq_import_executions_session_fingerprint")
  @@index([organizationId, importSessionId], map: "idx_import_executions_org_session")
  @@index([organizationId, id], map: "idx_import_executions_org_id")
  @@map("import_executions")
}

model ImportRecord {
  id              String                     @id @default(uuid(7)) @db.Uuid
  organizationId  String                     @map("organization_id") @db.Uuid
  importSessionId String                     @map("import_session_id") @db.Uuid
  executionId     String                     @map("execution_id") @db.Uuid
  recordNumber    Int                        @map("record_number")
  classification  ImportRecordClassification
  payload         Json?                      @db.JsonB
  errors          Json?                      @db.JsonB
  createdAt       DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  importSession ImportSession  @relation(fields: [importSessionId], references: [id], onDelete: Cascade)
  execution     ImportExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@unique([executionId, recordNumber], map: "uq_import_records_execution_record_number")
  @@index([organizationId, importSessionId, classification, recordNumber], map: "idx_import_records_org_session_class_record")
  @@index([organizationId, executionId], map: "idx_import_records_org_execution")
  @@map("import_records")
}

model ImportColumn {
  id              String @id @default(uuid(7)) @db.Uuid
  importSessionId String @map("import_session_id") @db.Uuid
  name            String @db.VarChar(255)
  position        Int

  importSession ImportSession @relation(fields: [importSessionId], references: [id], onDelete: Cascade)

  @@unique([importSessionId, position], map: "uq_import_columns_session_id_position")
  @@unique([importSessionId, name], map: "uq_import_columns_session_id_name")
  @@index([importSessionId], map: "idx_import_columns_import_session_id")
  @@map("import_columns")
}

model ImportAccessToken {
  id              String    @id @default(uuid(7)) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  importSessionId String    @map("import_session_id") @db.Uuid
  issuerApiKeyId  String    @map("issuer_api_key_id") @db.Uuid
  tokenHash       String    @unique(map: "uq_import_access_tokens_token_hash") @map("token_hash") @db.VarChar(64)
  tokenPrefix     String    @map("token_prefix") @db.VarChar(24)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  importSession ImportSession @relation(fields: [importSessionId], references: [id], onDelete: Cascade)
  issuerApiKey  ApiKey        @relation(fields: [issuerApiKeyId], references: [id], onDelete: Restrict)

  @@index([importSessionId], map: "idx_import_access_tokens_import_session_id")
  @@index([organizationId], map: "idx_import_access_tokens_organization_id")
  @@index([expiresAt], map: "idx_import_access_tokens_expires_at")
  @@map("import_access_tokens")
}

# API base used by the embed. Do not include secrets or API keys.
VITE_OPENIMPORT_API_BASE_URL=http://localhost:3000/api/v1

# Comma-separated parent origins allowed to initialize the iframe via postMessage.
# Wildcard origins are rejected. Required in production.
VITE_OPENIMPORT_PARENT_ORIGINS=http://localhost:5173

# Public repository URL for header/footer links. Leave empty until the published
# remote is confirmed. Do not guess a GitHub path.
VITE_OPENIMPORT_REPOSITORY_URL=

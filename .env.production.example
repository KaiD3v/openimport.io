# Copy to .env.production and replace every CHANGE_ME value.
# Do not reuse docker-compose.yml (development) credentials.

NODE_ENV=production
PORT=3000
LOG_LEVEL=info
ENABLE_DOCS=false

POSTGRES_USER=openimport
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=openimport
# Compose builds DATABASE_URL / REDIS_URL / S3_ENDPOINT from the values
# below. Do not export a host DATABASE_URL when running Compose — it would
# leak localhost into interpolation if the file still referenced ${DATABASE_URL}.
# POSTGRES_PASSWORD must be URL-safe (no @ : / ? #).
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=CHANGE_ME_S3_ACCESS_KEY
S3_SECRET_ACCESS_KEY=CHANGE_ME_S3_SECRET_ACCESS_KEY
S3_BUCKET=openimport
S3_FORCE_PATH_STYLE=true

# Comma-separated browser origins allowed to call the API. No wildcard.
ALLOWED_ORIGINS=https://app.example.com

# 64 lowercase hex characters.
WEBHOOK_SECRET_ENCRYPTION_KEY=CHANGE_ME_64_LOWERCASE_HEX_CHARS

# Reverse proxy hop count in front of the API container.
# Compose topology is client → nginx → backend: use 1 (never unrestricted true).
# nginx overwrites X-Forwarded-For with $remote_addr so clients cannot spoof.
TRUST_PROXY=1
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_PRE_AUTH_MAX=600
RATE_LIMIT_MAX=300
RATE_LIMIT_UPLOAD_MAX=20
RATE_LIMIT_PREVIEW_MAX=60
RATE_LIMIT_CONFIRM_MAX=30
RATE_LIMIT_ACCESS_TOKEN_MAX=30
RATE_LIMIT_WEBHOOK_MAX=20
RATE_LIMIT_TRUSTED_PROXY=true

HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_HEADERS_TIMEOUT_MS=15000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
HTTP_MAX_REQUESTS_PER_SOCKET=100
HEALTH_PROBE_TIMEOUT_MS=2000

WEBHOOK_SSRF_ALLOW_PRIVATE_TARGETS=false

# Host systems allowed to embed the frontend (CSP frame-ancestors). No '*'.
FRONTEND_FRAME_ANCESTORS=https://app.example.com
VITE_OPENIMPORT_PARENT_ORIGINS=https://app.example.com
VITE_OPENIMPORT_API_BASE_URL=/api/v1

# Optional public repository URL for frontend header/footer. Leave empty to hide
# repository links until the published remote is confirmed.
VITE_OPENIMPORT_REPOSITORY_URL=
